<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pro Student Rewards</title>
    
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1208999655797480" crossorigin="anonymous"></script>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; background: #f3f4f6; }
        .glass { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }
        .gradient-card { background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); }
        #wheel { transition: transform 4s cubic-bezier(0.15, 0, 0.15, 1); }
        .reward-pop { animation: bounce 0.5s ease infinite alternate; }
        @keyframes bounce { from { transform: translateY(0); } to { transform: translateY(-5px); } }
    </style>
</head>
<body class="pb-24">

    <div class="gradient-card p-10 rounded-b-[50px] text-white shadow-2xl text-center relative overflow-hidden">
        <div class="absolute top-0 right-0 p-4 opacity-20 text-6xl"><i class="fas fa-coins"></i></div>
        <p class="text-xs opacity-80 uppercase tracking-tighter">Your Total Earning</p>
        <h1 class="text-6xl font-black mt-1"><span id="balance">500</span> <small class="text-lg">Coins</small></h1>
        <div class="mt-6 flex justify-center gap-3">
            <button onclick="alert('Withdrawal request for ₹' + (balance/100) + ' sent!')" class="bg-white text-indigo-600 px-8 py-3 rounded-2xl font-bold shadow-lg active:scale-90 transition">Redeem</button>
            <button onclick="promoCode()" class="bg-indigo-900/40 px-6 py-3 rounded-2xl font-bold border border-white/20 active:scale-90 transition">Code</button>
        </div>
    </div>

    <div class="p-6 space-y-5">
        
        <div class="bg-white p-2 rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <p class="text-[9px] text-gray-400 text-center mb-1 uppercase tracking-widest">Sponsored Content</p>
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="ca-pub-1208999655797480"
                 data-ad-slot="3238837852"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>

        <div class="glass p-6 rounded-[40px] shadow-sm text-center border border-white">
            <h3 class="font-bold text-gray-700 mb-4 text-sm">LUCKY SPIN WHEEL</h3>
            <div class="relative w-44 h-44 mx-auto mb-5 bg-indigo-50 rounded-full border-4 border-indigo-400 flex items-center justify-center shadow-inner">
                <div id="wheel" class="w-full h-full flex items-center justify-center text-5xl">🎡</div>
                <div class="absolute top-0 w-1.5 h-6 bg-red-500 rounded-full shadow-md"></div>
            </div>
            <button onclick="spinNow()" id="spinBtn" class="bg-indigo-600 text-white w-full py-4 rounded-2xl font-black shadow-xl hover:bg-indigo-700 active:scale-95 transition">TRY YOUR LUCK</button>
        </div>

        <div onclick="startMath()" class="glass p-5 rounded-[30px] flex items-center gap-4 shadow-sm border border-white cursor-pointer active:scale-95 transition">
            <div class="bg-orange-100 p-4 rounded-2xl text-orange-600"><i class="fas fa-brain fa-lg"></i></div>
            <div class="flex-1 text-left">
                <h3 class="font-bold text-gray-800">Brain Quiz</h3>
                <p class="text-[10px] text-gray-400 font-bold uppercase">Solve & Earn +20 Coins</p>
            </div>
            <div class="text-green-500 font-black">+20</div>
        </div>

        <div onclick="dailyBonus()" class="glass p-5 rounded-[30px] flex items-center gap-4 shadow-sm border border-white cursor-pointer active:scale-95 transition">
            <div class="bg-green-100 p-4 rounded-2xl text-green-600"><i class="fas fa-calendar-star fa-lg"></i></div>
            <div class="flex-1 text-left">
                <h3 class="font-bold text-gray-800">Daily Check-in</h3>
                <p class="text-[10px] text-gray-400 font-bold uppercase">Reward: 50 Coins</p>
            </div>
            <div class="text-green-500 font-black">+50</div>
        </div>

    </div>

    <p onclick="adminLogin()" class="text-center text-[8px] text-gray-300 mt-10">App ID: 1208999655797480 | v4.2</p>

    <script>
        let balance = 500;
        let isSpinning = false;

        function updateUI() {
            document.getElementById('balance').innerText = balance;
        }

        function spinNow() {
            if (isSpinning) return;
            isSpinning = true;
            let wheel = document.getElementById('wheel');
            let deg = Math.floor(5000 + Math.random() * 5000);
            wheel.style.transform = `rotate(${deg}deg)`;
            
            setTimeout(() => {
                let prize = Math.floor(Math.random() * 80) + 15;
                balance += prize;
                updateUI();
                alert("🎉 Jackpot! You won " + prize + " Coins!");
                isSpinning = false;
            }, 4000);
        }

        function startMath() {
            let n1 = Math.floor(Math.random() * 30) + 5;
            let n2 = Math.floor(Math.random() * 30) + 5;
            let ans = prompt("Math Test: What is " + n1 + " + " + n2 + " ?");
            if (ans == (n1 + n2)) {
                balance += 20;
                updateUI();
                alert("Smart Move! +20 Coins.");
            } else {
                alert("Wrong! Try again.");
            }
        }

        function dailyBonus() {
            balance += 50;
            updateUI();
            alert("Checked-in! 50 Coins added.");
        }

        function promoCode() {
            let code = prompt("Enter Promo Code:");
            if (code === "STUDENT786") {
                balance += 100;
                updateUI();
                alert("Secret Code Success! +100 Coins.");
            } else {
                alert("Invalid Code!");
            }
        }

        function adminLogin() {
            let p = prompt("Password:");
            if(p === "admin786") alert("Admin: All UPI requests approved!");
        }
    </script>
</body>
</html>
